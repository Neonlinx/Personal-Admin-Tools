// ============================================================================
// Nilesoft Shell - V16 OFFICE BASE
// Scope: SOLO documenti Office e OpenDocument:
//   Excel  .xlsx .xls .xlsm .xlsb
//   Word   .docx .doc .docm .rtf
//   PowerPoint .pptx .ppt .pptm
//   OpenDocument .odt .ods .odp
// Schema: copiato dalla V5 TEXT (collaudata), adattato ai documenti Office.
// Icone: SVG di images.nss (icon.nome); file salvato con UN SOLO BOM.
// ============================================================================

// ---------------------------------------------------------------------------
// BLOCCO PRINCIPALE
// ---------------------------------------------------------------------------

modify(type='file' where=(str.equals(str.lower(sel.file.ext), '.xlsx') || str.equals(str.lower(sel.file.ext), '.xls') || str.equals(str.lower(sel.file.ext), '.xlsm') || str.equals(str.lower(sel.file.ext), '.xlsb') || str.equals(str.lower(sel.file.ext), '.docx') || str.equals(str.lower(sel.file.ext), '.doc') || str.equals(str.lower(sel.file.ext), '.docm') || str.equals(str.lower(sel.file.ext), '.pptx') || str.equals(str.lower(sel.file.ext), '.ppt') || str.equals(str.lower(sel.file.ext), '.pptm') || str.equals(str.lower(sel.file.ext), '.odt') || str.equals(str.lower(sel.file.ext), '.ods') || str.equals(str.lower(sel.file.ext), '.odp') || str.equals(str.lower(sel.file.ext), '.rtf')) find='Apri' pos=0)
