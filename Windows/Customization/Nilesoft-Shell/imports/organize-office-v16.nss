// ---------------------------------------------------------------------------
// SISTEMA
// ---------------------------------------------------------------------------

menu(type='file' where=(str.equals(str.lower(sel.file.ext), '.xlsx') || str.equals(str.lower(sel.file.ext), '.xls') || str.equals(str.lower(sel.file.ext), '.xlsm') || str.equals(str.lower(sel.file.ext), '.xlsb') || str.equals(str.lower(sel.file.ext), '.docx') || str.equals(str.lower(sel.file.ext), '.doc') || str.equals(str.lower(sel.file.ext), '.docm') || str.equals(str.lower(sel.file.ext), '.pptx') || str.equals(str.lower(sel.file.ext), '.ppt') || str.equals(str.lower(sel.file.ext), '.pptm') || str.equals(str.lower(sel.file.ext), '.odt') || str.equals(str.lower(sel.file.ext), '.ods') || str.equals(str.lower(sel.file.ext), '.odp') || str.equals(str.lower(sel.file.ext), '.rtf')) title='Sistema' image=icon.settings)
{
    menu(title='Owner e permessi' image=icon.run_as_administrator)
    {
        item(title='View owner'
             image='imageres.dll,-1029'
             cmd='powershell.exe'
             args="-NoExit -Command \"Get-ACL '@sel.path' | Format-List -Property Owner\"")

        menu(title='Change owner' image='imageres.dll,-1029')
        {
            item(title='Change to Administrators'
                 admin
                 cmd args='/c icacls "@sel.path" /setowner "Administrators" /c & pause')

            item(title='Change to Everyone'
                 admin
                 cmd args='/c icacls "@sel.path" /setowner "Everyone" /c & pause')

            item(title='Change to TrustedInstaller'
                 admin
                 cmd args='/c icacls "@sel.path" /setowner "NT Service\TrustedInstaller" /c /l & pause')
        }

        separator

        item(title='Take ownership'
             image=icon.run_as_administrator
             admin
             cmd args='/K takeown /f "@sel.path" && icacls "@sel.path" /grant *S-1-5-32-544:F /c /l')
    }
}


